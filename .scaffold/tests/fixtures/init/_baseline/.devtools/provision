#!/usr/bin/env php
<?php

/**
 * @file
 * Provision a website using existing codebase.
 *
 * - Installs Drupal using SQLite database.
 * - Enables modules.
 * - Serves site and generates one-time login link.
 */

declare(strict_types=1);

namespace DrupalExtensionScaffold\DevTools;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------
// Variables.
// -----------------------------------------------------------------------------

// Webserver hostname.
$webserver_host = getenv_default('WEBSERVER_HOST', 'localhost');

// Webserver port.
$webserver_port = getenv_default('WEBSERVER_PORT', '8000');

// Drupal profile to use when installing the site.
$drupal_profile = getenv_default('DRUPAL_PROFILE', 'standard');

// -----------------------------------------------------------------------------

echo '===============================' . PHP_EOL;
echo '         🚀 PROVISION          ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;

$ext_info = extension_info();
$extension = $ext_info['name'];
$extension_type = $ext_info['type'];

$db_file = '/tmp/site_' . $extension . '.sqlite';

TASK('Installing Drupal into SQLite database %s.', $db_file);

$exit_code = 0;
$db_status = trim(drush('status --field=db-status', NULL, $exit_code));
if ($db_status === 'Connected') {
  drush('sql:drop -y', NULL, $exit_code);
}

drush(sprintf('site-install %%s -y --db-url="sqlite://localhost/%s" --account-name=admin install_configure_form.enable_update_status_module=NULL install_configure_form.enable_update_status_emails=NULL', $db_file), [$drupal_profile]);

PASS('Drupal installed.');

drush('status');

TASK('Enabling extension %s.', $extension);
if ($extension_type === 'theme') {
  drush('theme:enable %s', [$extension]);
}
else {
  drush('pm:enable %s', [$extension]);
}

TASK('Clearing caches.');
drush('cr');

TASK('Enabling suggested modules, if any.');
$composer_json = (array) json_decode((string) file_get_contents('composer.json'), TRUE);
if (isset($composer_json['suggest']) && is_array($composer_json['suggest'])) {
  foreach (array_keys($composer_json['suggest']) as $suggest) {
    if (!str_starts_with((string) $suggest, 'drupal/')) {
      continue;
    }
    // Remove "drupal/" prefix and anything after ":".
    $module_name = preg_replace('/^drupal\//', '', (string) $suggest);
    $module_name = explode(':', (string) $module_name)[0];
    drush('pm:enable %s', [$module_name]);
  }
}
PASS('Suggested modules enabled.');

TASK('Pre-warming caches.');
@file_get_contents(sprintf('http://%s:%s', $webserver_host, $webserver_port));
PASS('Caches pre-warmed.');

echo PHP_EOL;
echo '===============================' . PHP_EOL;
echo '   🚀 PROVISION COMPLETE  ✅  ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
echo 'Site URL:            http://' . $webserver_host . ':' . $webserver_port . PHP_EOL;
echo 'One-time login link: ';
echo drush(sprintf('uli -l http://%s:%s --no-browser', $webserver_host, $webserver_port));
echo PHP_EOL;
if (file_exists('.ahoy.yml')) {
  echo 'Run `ahoy` to see available commands.' . PHP_EOL;
}
if (file_exists('Makefile')) {
  echo 'Run `make` to see available commands.' . PHP_EOL;
}
echo PHP_EOL;
